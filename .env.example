# =============================================================================
# Environment-specific .env files
# =============================================================================
# The app auto-loads the correct file based on the ENVIRONMENT variable:
#
#   ENVIRONMENT=development  →  loads .env.development
#   ENVIRONMENT=production   →  loads .env.production
#   (not set)                →  falls back to .env
#
# Usage:
#   cp .env.example .env.development   # edit for local dev
#   cp .env.example .env.production    # edit for production
#   ENVIRONMENT=production python main.py
#
# Docker: docker-compose.yml auto-loads .env + sets explicit overrides
# =============================================================================

# Database Configuration (NeonDB)
# Direct connection (recommended for asyncpg/pgvector):
#   postgresql://postgres:postgres@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Pooled connection (via Neon's pgbouncer — NOT recommended for pgvector):
#   postgresql://postgres:postgres@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/specifyplus
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
DATABASE_SSL=disable

# DeepSeek (chat provider, required). Keep deepseek-chat: deepseek-reasoner
# has no tool calling, which the agent needs.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (optional chat fallback, used only when DEEPSEEK_API_KEY is
# empty and this key is set)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model on OpenRouter only
OPENAI_MODEL=openai/gpt-4o

# Gemini (embeddings provider, required for KB vector search)
# ---------------------------------------------------------------------------
# Embeddings are split from chat: DeepSeek serves no embedding models (and
# the OpenRouter account returns HTTP 402 on /embeddings). Without
# GEMINI_API_KEY the API logs an error, /readyz reports embeddings=missing
# and KB search runs lexical-only (alerted). EMBEDDING_MODEL (embed through
# the chat provider instead) is an explicit opt-in; leave it unset.
# Get a key at https://aistudio.google.com/apikey
# Real keys live in the gitignored .env — keep this commented out here.
# An empty assignment would still shadow the value .env provides.
# GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-embedding-001 returns 3072 dims by default; the code requests 1536 to
# match knowledge_base.embedding vector(1536) in database/schema.sql.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Kafka Configuration
# Local dev (PLAINTEXT):             localhost:9092
# Docker Compose (internal):         kafka:29092
# OCI Streaming (SASL_SSL):         cell-1.streaming.<region>.oci.oraclecloud.com:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Set to false to run without a Kafka broker (degraded mode):
#   API stays up, webform runs the agent synchronously, worker does metrics only.
ENABLE_KAFKA=true
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=placeholder
KAFKA_SASL_PASSWORD=placeholder

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Rate Limiting
# Default: requests per minute per IP (global limit)
RATE_LIMIT_PER_MINUTE=100
# Strict limit for sensitive endpoints (reply, webhooks, ingest)
STRICT_RATE_LIMIT_PER_MINUTE=10
# Optional: Redis URL for shared rate limiting across multiple instances.
#   redis://localhost:6379/0
# Leave empty to use in-memory (not shared between workers/instances).
REDIS_URL=

# Security
# Backend reads API_KEY first, then API_KEY_SECRET. Deploy configs
# (docker-compose, render.yaml, k8s) set API_KEY — keep both in sync.
API_KEY_SECRET=placeholder-secret-key-change-in-prod
# Key the Playwright tests (tests/test_e2e_playwright.py) send as X-API-Key.
# Optional: when unset they use API_KEY_SECRET, which matches a server started
# from this file. Set it when the server uses API_KEY or a different key
# (the test API_KEY is overwritten by tests/conftest.py, so it can't be reused).
# scripts/setup_e2e.sh sets it for you.
# E2E_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_DOMAINS=techflow-analytics.com

# Gmail Configuration
GMAIL_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=placeholder-client-secret
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.readonly
GMAIL_POLLING_INTERVAL_SECONDS=60
GMAIL_TOKEN_REFRESH_URL=https://oauth2.googleapis.com/token
# OAuth token the outbound sender uses to send replies. It must already exist:
# the worker never runs the interactive OAuth flow for outbound mail.
GMAIL_TOKEN_FILE=gmail_token.json

# Outbound reply delivery (workers/notification_sender.py)
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_WAIT_SECONDS=2

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=your_webhook_secret_here

# Voice channel (STT/TTS/NLP translation)
# ---------------------------------------------------------------------------
# Speech-to-text. Uses Groq Whisper by default (fast + most accurate),
# falls back to OpenAI Whisper, then to a degraded (clarification) mode.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-your-openai-key-here
STT_PROVIDER=auto            # auto | groq | openai
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_MODEL=whisper-1
# Confidence gate for "pick it up first time": below this the agent asks the
# customer to repeat instead of guessing (range 0..1, default 0.5).
STT_CONFIDENCE_THRESHOLD=0.5
# Text-to-speech. OpenAI TTS by default, gTTS (offline) fallback, else text-only.
TTS_PROVIDER=auto            # auto | openai | gtts | none
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Twilio Voice Call (optional — for phone call webhooks)
TWILIO_VOICE_NUMBER=+1234567890
ENABLE_VOICE=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# docker-compose bakes this into the web-form bundle (browser-reachable API URL)
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPPORT_EMAIL=support@techflow-analytics.com
NEXT_PUBLIC_COMPANY_NAME=TechFlow Analytics

# Metrics & Monitoring
METRICS_WINDOW_MINUTES=5
METRICS_RETENTION_DAYS=30
ENABLE_METRICS=true

# Feature Flags
ENABLE_GMAIL_POLLING=true
ENABLE_WHATSAPP_WEBHOOK=true
ENABLE_WEB_FORM=true
KB_USE_SEMANTIC_SEARCH=true

# Worker Configuration
WORKER_MODE=processor
MESSAGE_PROCESSOR_BATCH_SIZE=10
MESSAGE_PROCESSOR_TIMEOUT_SECONDS=30
ESCALATION_NOTIFY_TEAM=true
