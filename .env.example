# Database Configuration
DATABASE_URL=postgresql://***REDACTED_USER***:***REDACTED_PASS***@localhost:5432/specifyplus
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# OpenAI Configuration
OPENAI_API_KEY=sk-placeholder-do-not-use
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=placeholder
KAFKA_SASL_PASSWORD=placeholder

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Security
API_KEY_SECRET=placeholder-secret-key-change-in-prod
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_DOMAINS=techflow-analytics.com

# Gmail Configuration
GMAIL_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=placeholder-client-secret
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.readonly
GMAIL_POLLING_INTERVAL_SECONDS=60
GMAIL_TOKEN_REFRESH_URL=https://oauth2.googleapis.com/token

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPPORT_EMAIL=support@techflow-analytics.com
NEXT_PUBLIC_COMPANY_NAME=TechFlow Analytics

# Metrics & Monitoring
METRICS_WINDOW_MINUTES=5
METRICS_RETENTION_DAYS=30
ENABLE_METRICS=true

# Feature Flags
ENABLE_GMAIL_POLLING=true
ENABLE_WHATSAPP_WEBHOOK=true
ENABLE_WEB_FORM=true
KB_USE_SEMANTIC_SEARCH=true

# Worker Configuration
WORKER_MODE=processor
MESSAGE_PROCESSOR_BATCH_SIZE=10
MESSAGE_PROCESSOR_TIMEOUT_SECONDS=30
ESCALATION_NOTIFY_TEAM=true
